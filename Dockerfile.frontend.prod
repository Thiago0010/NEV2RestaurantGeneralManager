# =============================================================
# Frontend Dockerfile - Production (Oracle Cloud)
# Multi-stage: build com Node, serve com nginx leve (alpine).
# =============================================================

# -------- Stage 1: Build --------
FROM node:20-alpine AS builder

WORKDIR /app

# Argumento de build pra URL da API em produção
#   docker build --build-arg VITE_API_URL=/api/v1 ...
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# -------- Stage 2: Serve --------
FROM nginx:1.27-alpine AS production

# Remove a config default
RUN rm /etc/nginx/conf.d/default.conf

# Copia o nginx otimizado pra produção
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copia o build estático
COPY --from=builder /app/dist /usr/share/nginx/html

# Usuário não-root (nginx alpine já roda como nginx)
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
